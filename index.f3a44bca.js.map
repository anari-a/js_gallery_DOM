"use strict";
var gallery = document.querySelector(".gallery");
var mainImg = document.querySelector(".largeImg");
gallery.addEventListener("click", function(e) {
    var target = e.target;
    var link = target.closest("a");
    if (!link) return;
    e.preventDefault();
    var bigImageUrl = link.getAttribute("src") || link.dataset.full;
    if (!bigImageUrl) return;
    mainImg.src = bigImageUrl;
});

